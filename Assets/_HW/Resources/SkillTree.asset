  nodes:
  - id: syntax.sequence
    kind: 0
    displayName: "\uC21C\uCC28 \uC2E4\uD589"
    prerequisites: []
    autoUnlock: 1
    cost: []
    unlocksBlocks: 0e00000010000000i
    description:
      summary: "\uBE14\uB85D\uC744 \uC704\uC5D0\uC11C \uC544\uB798\uB85C \uD558\uB098\uC529 \uCC28\uB840\uB300\uB85C \uC2E4\uD589\uD569\uB2C8\uB2E4."
      detail: "\uD568\uC218 body\uC5D0 \uB193\uC778 \uBE14\uB85D\uC740 \uC704\uC5D0\uC11C\uBD80\uD130 \uD55C \uAC1C\uC529 \uC2E4\uD589\uB429\uB2C8\uB2E4. C \uC2A4\uD0AC \uBE14\uB85D\uC744 \uC774\uC5B4 \uB193\uC73C\uBA74 \uCC28\uB840\uB300\uB85C \uC2DC\uC804\uD558\uACE0, wait \uBE14\uB85D\uC73C\uB85C \uB2E4\uC74C \uBE14\uB85D\uAE4C\uC9C0 \uAE30\uB2E4\uB9B4 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    note: "\uCC98\uC74C\uBD80\uD130. \uBE14\uB85D\uC744 \uC704\uC5D0\uC11C\uBD80\uD130 \uCC28\uB840\uB85C \uC2E4\uD589. C \uC2A4\uD0AC \uBE14\uB85D, \uAE30\uB2E4\uB9AC\uAE30"
  - id: syntax.variable
    kind: 0
    displayName: "\uBCC0\uC218"
    prerequisites:
    - syntax.sequence
    autoUnlock: 0
    cost:
    - materialId: bug_fragment
      count: 2
    unlocksBlocks: 0000000001000000i
    description:
      summary: "\uAC12\uC5D0 \uC774\uB984\uC744 \uBD99\uC5EC \uB2F4\uC544 \uB450\uACE0 \uB2E4\uC2DC \uC501\uB2C8\uB2E4."
      detail: "\uC120\uC5B8 \uBE14\uB85D(int x = 3;)\uC73C\uB85C \uBCC0\uC218\uB97C \uB9CC\uB4E4\uACE0, \uB300\uC785 \uBE14\uB85D(x = 5;)\uC73C\uB85C \uB2F4\uAE34 \uAC12\uC744 \uBC14\uAFC9\uB2C8\uB2E4. \uD0C0\uC785\uC740 int, float, bool, char, string \uC911\uC5D0\uC11C \uACE0\uB985\uB2C8\uB2E4."
    note: 
  - id: syntax.arithmetic
    kind: 0
    displayName: "\uC5F0\uC0B0"
    prerequisites:
    - syntax.variable
    autoUnlock: 0
    cost:
    - materialId: bug_fragment
      count: 3
    unlocksBlocks: 02000000i
    description:
      summary: "+ - * / % \uB85C \uAC12\uC744 \uACC4\uC0B0\uD569\uB2C8\uB2E4."
      detail: "\uC5F0\uC0B0 \uBE14\uB85D\uC740 \uAC12 \uCE78\uC5D0 \uB07C\uC6CC \uC501\uB2C8\uB2E4. \uB450 \uAC12\uC744 \uB354\uD558\uACE0(+), \uBE7C\uACE0(-), \uACF1\uD558\uACE0(*), \uB098\uB204\uACE0(/), \uB098\uBA38\uC9C0(%)\uB97C \uAD6C\uD569\uB2C8\uB2E4."
    note: 
  - id: syntax.if
    kind: 0
    displayName: "if\uBB38"
    prerequisites:
    - syntax.arithmetic
    autoUnlock: 0
    cost:
    - materialId: bug_fragment
      count: 4
    unlocksBlocks: 0600000003000000i
    description:
      summary: "\uC870\uAC74\uC774 \uCC38\uC77C \uB54C\uB9CC \uC548\uCABD \uBE14\uB85D\uC744 \uC2E4\uD589\uD569\uB2C8\uB2E4."
      detail: "if \uBE14\uB85D\uC758 \uC870\uAC74 \uCE78\uC5D0 \uBE44\uAD50 \uBE14\uB85D(> < == != >= <=)\uC744 \uB07C\uC6CC \uC501\uB2C8\uB2E4. \uC870\uAC74\uC774 \uAC70\uC9D3\uC774\uBA74 \uC548\uCABD\uC744 \uAC74\uB108\uB6F0\uACE0, \uBC14\uB85C \uC544\uB798\uC5D0 else if\uB098 else\uB97C \uBD99\uC5EC \uB2E4\uB978 \uACBD\uC6B0\uB97C \uC774\uC5B4\uC11C \uACE0\uB97C \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    note: "\uBE44\uAD50(> < ==)\uB294 \uC870\uAC74\uC5D0 \uC4F0\uBBC0\uB85C if\uBB38\uACFC \uAC19\uC774 \uC5F0\uB2E4 (\uAC00\uC815)"
  - id: syntax.logic
    kind: 0
    displayName: "\uB17C\uB9AC \uC5F0\uC0B0"
    prerequisites:
    - syntax.if
    autoUnlock: 0
    cost:
    - materialId: bug_fragment
      count: 5
    unlocksBlocks: 0400000005000000i
    description:
      summary: "&& || ! \uB85C \uC5EC\uB7EC \uC870\uAC74\uC744 \uD558\uB098\uB85C \uD569\uCE69\uB2C8\uB2E4."
      detail: "&&\uB294 \uB450 \uC870\uAC74\uC774 \uBAA8\uB450 \uCC38\uC77C \uB54C, ||\uB294 \uD558\uB098\uB77C\uB3C4 \uCC38\uC77C \uB54C \uCC38\uC785\uB2C8\uB2E4. Not(!)\uC740 \uCC38\uACFC \uAC70\uC9D3\uC744 \uB4A4\uC9D1\uC2B5\uB2C8\uB2E4."
    note: 
  - id: syntax.for
    kind: 0
    displayName: "for\uBB38"
    prerequisites:
    - syntax.logic
    autoUnlock: 0
    cost:
    - materialId: bug_fragment
      count: 6
    unlocksBlocks: 07000000090000000a000000i
    description:
      summary: "\uC815\uD574\uC9C4 \uD69F\uC218\uB9CC\uD07C \uC548\uCABD \uBE14\uB85D\uC744 \uBC18\uBCF5\uD569\uB2C8\uB2E4."
      detail: "for (int i = 0; i < 10; i++)\uCC98\uB7FC i\uAC00 \uB05D \uAC12\uC5D0 \uB2FF\uC744 \uB54C\uAE4C\uC9C0 \uBC18\uBCF5\uD569\uB2C8\uB2E4. break\uB294 \uBC18\uBCF5\uC744 \uBC14\uB85C \uB05D\uB0B4\uACE0, continue\uB294 \uC774\uBC88 \uCC28\uB840\uB97C \uAC74\uB108\uB6F0\uACE0 \uB2E4\uC74C \uBC18\uBCF5\uC73C\uB85C \uB118\uC5B4\uAC11\uB2C8\uB2E4."
    note: "break, continue\uB294 \uCCAB \uBC18\uBCF5\uBB38\uACFC \uAC19\uC774 \uC5F0\uB2E4 (\uAC00\uC815)"
  - id: syntax.while
    kind: 0
    displayName: "while\uBB38"
    prerequisites:
    - syntax.for
    autoUnlock: 0
    cost:
    - materialId: bug_fragment
      count: 7
    unlocksBlocks: 08000000i
    description:
      summary: "\uC870\uAC74\uC774 \uCC38\uC778 \uB3D9\uC548 \uC548\uCABD \uBE14\uB85D\uC744 \uACC4\uC18D \uBC18\uBCF5\uD569\uB2C8\uB2E4."
      detail: "\uBC18\uBCF5\uD560 \uD69F\uC218\uB97C \uBBF8\uB9AC \uBAA8\uB97C \uB54C \uC501\uB2C8\uB2E4. \uC870\uAC74\uC774 \uAC70\uC9D3\uC774 \uB418\uC9C0 \uC54A\uC73C\uBA74 \uBC18\uBCF5\uC774 \uB05D\uB098\uC9C0 \uC54A\uC73C\uB2C8, \uC548\uCABD\uC5D0\uC11C \uC870\uAC74\uC744 \uBC14\uAFB8\uAC70\uB098 break\uB85C \uBE60\uC838\uB098\uC624\uC138\uC694."
    note: 
  - id: syntax.function
    kind: 0
    displayName: "\uD568\uC218"
    prerequisites:
    - syntax.while
    autoUnlock: 0
    cost:
    - materialId: bug_fragment
      count: 8
    unlocksBlocks: 0f000000i
    description:
      summary: "\uBE14\uB85D \uBB36\uC74C\uC5D0 \uC774\uB984\uC744 \uBD99\uC5EC \uB450\uACE0 \uD544\uC694\uD560 \uB54C \uBD80\uB985\uB2C8\uB2E4."
      detail: "\uD398\uC774\uC9C0\uC5D0 \uB9CC\uB4E0 \uD568\uC218\uB294 \uB2E4\uB978 \uD568\uC218 \uC548\uC5D0\uC11C \uD568\uC218 \uBE14\uB85D\uC73C\uB85C \uBD80\uB97C \uC218 \uC788\uC2B5\uB2C8\uB2E4. return \uBE14\uB85D\uC73C\uB85C \uD568\uC218\uB97C \uB05D\uB0B4\uACE0, \uBD80\uB978 \uCABD\uC5D0 \uAC12\uC744 \uB3CC\uB824\uC90D\uB2C8\uB2E4."
    note: "\uC0AC\uC6A9\uC790 \uC815\uC758 \uD568\uC218 \uB9CC\uB4E4\uAE30\xB7\uBD80\uB974\uAE30, return. \uD568\uC218 \uBE14\uB85D(BlockKind.Function)\uC740 C \uC2A4\uD0AC\uACFC \uAC19\uC740 \uC885\uB958\uB77C \uC5EC\uAE30\uC11C \uB9C9\uC9C0 \uC54A\uB294\uB2E4"
  - id: syntax.list
    kind: 0
    displayName: list
    prerequisites:
    - syntax.function
    autoUnlock: 0
    cost:
    - materialId: bug_fragment
      count: 10
    unlocksBlocks: 0b0000001100000012000000i
    description:
      summary: "\uAC19\uC740 \uD0C0\uC785\uC758 \uAC12 \uC5EC\uB7EC \uAC1C\uB97C \uD55C \uC904\uB85C \uB2F4\uC2B5\uB2C8\uB2E4."
      detail: "\uBC30\uC5F4 \uB9CC\uB4E4\uAE30 \uBE14\uB85D(int arr[3];)\uC73C\uB85C \uCE78 \uC218\uB97C \uC815\uD574 \uB9CC\uB4E4\uACE0, arr[i]\uB85C i\uBC88\uC9F8 \uCE78\uC744 \uC77D\uAC70\uB098 \uBC14\uAFC9\uB2C8\uB2E4. \uCE78 \uBC88\uD638\uB294 0\uBD80\uD130 \uC149\uB2C8\uB2E4."
    note: "\uBC30\uC5F4 \uB9CC\uB4E4\uAE30 \uBE14\uB85D\uC744 \uAC19\uC774 \uC5F0\uB2E4 (\uAC00\uC815)"
  - id: syntax.type
    kind: 0
    displayName: "Type \uC815\uC758"
    prerequisites:
