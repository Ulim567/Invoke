    unlocksBlocks: 
    description:
      summary: "\uC5EC\uB7EC \uBCC0\uC218\uB97C \uD558\uB098\uB85C \uBB36\uC740 \uB098\uB9CC\uC758 \uD0C0\uC785(struct)\uC744 \uB9CC\uB4ED\uB2C8\uB2E4."
      detail: "\uC11C\uB85C \uAD00\uB828\uB41C \uAC12\uC744 \uD55C \uC774\uB984\uC73C\uB85C \uBB36\uC5B4 \uB2E4\uB8F9\uB2C8\uB2E4. \uC774 \uBB38\uBC95\uC73C\uB85C \uC4F0\uB294 \uBE14\uB85D\uC740 \uC544\uC9C1 \uC900\uBE44 \uC911\uC785\uB2C8\uB2E4."
    note: "struct \uB9CC\uB4E4\uAE30. \uBE14\uB85D\uC774 \uC544\uC9C1 \uC5C6\uC74C"
  - id: c.thrust
